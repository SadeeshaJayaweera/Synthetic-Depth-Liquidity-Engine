# Massive.com (formerly Polygon.io) API Configuration
# Sign up and retrieve your API key from https://massive.com/dashboard/keys
MASSIVE_API_KEY=your_massive_api_key_here

# Storage Configuration
# Path to local DuckDB database file. Defaults to data/synthetic_depth.duckdb
DUCKDB_PATH=data/synthetic_depth.duckdb

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Application Environment (development, staging, production)
ENVIRONMENT=development
